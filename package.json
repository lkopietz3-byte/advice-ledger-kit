{
  "name": "advice-ledger-kit",
  "version": "0.1.0",
  "description": "Grade the grader: measure whether a recommendation engine's advice was taken and whether it turned out right. Exposure-aligned before/after windows, separate floors per window with machine-readable refusal codes instead of a verdict, symmetric propose/refute thresholds, and a two-judge divergence detector that reports engine-was-right and human-was-right separately. Zero-dependency, domain-agnostic TypeScript.",
  "keywords": [
    "recommendation-quality",
    "calibration",
    "decision-log",
    "evaluation",
    "ab-testing",
    "honesty",
    "human-in-the-loop",
    "drift-detection"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/advice-ledger-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/advice-ledger-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/advice-ledger-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
